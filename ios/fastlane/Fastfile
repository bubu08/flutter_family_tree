def ensure_app_store_connect_api_key!
  key_path = ENV['APPSTORE_KEY_PATH']
  key_id = ENV['APPSTORE_KEY_ID']
  issuer_id = ENV['APPSTORE_ISSUER_ID']

  UI.user_error!("Set APPSTORE_KEY_PATH to your .p8 key file.") if key_path.to_s.empty?
  UI.user_error!("APP Store Connect API key file not found at #{key_path}.") unless File.exist?(key_path)
  UI.user_error!("Set APPSTORE_KEY_ID to your API key ID.") if key_id.to_s.empty?
  UI.user_error!("Set APPSTORE_ISSUER_ID to your Issuer ID.") if issuer_id.to_s.empty?

  app_store_connect_api_key(
    key_id: key_id,
    issuer_id: issuer_id,
    key_filepath: key_path,
    duration: 1200,
    in_house: false
  )
end

default_platform(:ios)

platform :ios do
  before_all do
    UI.user_error!("Set DEMO_SECRET environment variable before running Fastlane.") if (ENV["DEMO_SECRET"].nil? || ENV["DEMO_SECRET"].empty?)
    ensure_app_store_connect_api_key!
  end

  desc "Run Flutter unit tests"
  lane :tests do
    sh("flutter test --dart-define=DEMO_SECRET=#{ENV['DEMO_SECRET']}")
  end

  desc "Build iOS debug"
  lane :build_debug do
    sh("flutter build ios --debug --no-codesign --dart-define=DEMO_SECRET=#{ENV['DEMO_SECRET']}")
  end

  desc "Build release IPA"
  lane :build_release do
    sh("flutter build ipa --release --dart-define=DEMO_SECRET=#{ENV['DEMO_SECRET']}")
  end

  desc "Upload to TestFlight"
  lane :beta do
    build_release
    pilot(
      ipa: '../build/ios/ipa/Runner.ipa',
      skip_submission: true,
      skip_waiting_for_build_processing: true
    )
  end
end
